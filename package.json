{
  "name": "lorekeeper",
  "version": "0.0.0",
  "private": true,
  "description": "Toolkit for an AI-native Second Brain: a deterministic CLI over plain Markdown, plus a documentation PWA.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "bench:search": "npm run build && node packages/cli/dist/bench/run.js",
    "bench:context": "npm run build && node packages/cli/dist/bench/context.js",
    "demo:agent": "npm run build && node brand/demo/agent-demo.mjs",
    "brand:check": "node brand/tokens/build.mjs --check",
    "brand:assets": "node brand/assets/build.mjs",
    "brand:assets:check": "node brand/assets/build.mjs --check",
    "brand:diagrams": "node brand/diagrams/check.mjs",
    "brand:readme": "node brand/readme/build.mjs",
    "brand:readme:check": "node brand/readme/build.mjs --check",
    "brand:terminal": "node brand/terminal/build.mjs",
    "brand:terminal:check": "node brand/terminal/build.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "@wonder-wagon/themes": "file:../wonder-wagon-ui/packages/themes",
    "@wonder-wagon/tokens": "file:../wonder-wagon-ui/packages/tokens",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
