# Test fixtures are byte-exact inputs to round-trip tests. Line-ending
# normalization would silently rewrite the CRLF fixture and break the very
# property it exists to prove.
packages/core/test/fixtures/** -text

# Generated identity assets are byte-exact build products: `npm run
# brand:assets:check` reproduces them from the vector sources and compares
# bytes. Any line-ending translation would break that comparison on the
# platform that applied it.
brand/assets/*.png -text
brand/assets/*.ico -text

# The lore --help recording is the exact byte stream a pty received, carriage
# returns included; `npm run brand:readme:check` compares it with the binary.
brand/readme/*.pty -text
