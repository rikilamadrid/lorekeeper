# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Astro's generated types and content cache, rebuilt on every build.
.astro/

# Transient workspace state.
# Never ignore context/ wholesale — it holds durable project truth.
# current-feature.md is the file current-ticket.md replaced; it stays listed so
# a checkout predating the Pathfinder v4 ticket loop stays clean.
context/current-ticket.md
context/current-feature.md
context/handoff.md

# Orchestrator-mode worker worktrees and claim state. Machine-local: each
# worker's worktree lives here, and the orchestration engine refuses to claim
# a ticket until this entry exists.
/.pathfinder/

# Editor and OS
.DS_Store
